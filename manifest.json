{
  "manifest_version": 3,
  "name": "Online Comments Summarizer",
  "version": "1.0",
  "description": "Capture and analyse online comments with an LLM-based backend service",

  "permissions": [
    "scripting",
    "activeTab",
    "storage",
    "webRequest"
  ],

  "host_permissions": [
    "https://www.google.com/*",
    "https://weibo.com/*",
    "https://www.weibo.com/*",
    "https://twitter.com/*",
    "https://www.twitter.com/*",
    "https://x.com/*",
    "https://www.x.com/*",
    "https://www.reddit.com/*",
    "https://reddit.com/*"
  ],

  "background": {
    "service_worker": "background.js"
  },

  "content_scripts": [
    {
      "matches": [
        "https://weibo.com/*",
        "https://twitter.com/*",
        "https://x.com/*",
        "https://www.reddit.com/r/*/comments/*",
        "*://*.reddit.com/*"
      ],
      "js": ["content.js"],
      "run_at": "document_start"
    }
  ],

  "web_accessible_resources": [
    {
      "resources": ["injected.js","visual.html"],
      "matches": ["<all_urls>"]
    }
  ]
}